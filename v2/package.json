{
  "name": "l-town-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "server", "client"],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "start": "node server/dist/index.js",
    "lint": "tsc --noEmit --project server/tsconfig.json && tsc --noEmit --project client/tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.6.3"
  }
}
