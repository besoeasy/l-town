{
  "name": "l-town",
  "version": "1.1.1",
  "description": "L-Town — free open-source multiplayer browser FPS. No download, 300-player arena, procedural map, self-host via Docker or npx. Three.js + Node.js WebSockets.",
  "type": "module",
  "main": "server.js",
  "bin": {
    "l-town": "server.js"
  },
  "files": [
    "server.js",
    "public/",
    "sounds/"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js"
  },
  "keywords": [
    "fps",
    "first-person-shooter",
    "multiplayer",
    "multiplayer-game",
    "browser-game",
    "browser-fps",
    "io-game",
    "arena-shooter",
    "threejs",
    "three-js",
    "webgl",
    "websocket",
    "nodejs",
    "javascript",
    "self-hosted",
    "selfhosted",
    "docker",
    "procedural-generation",
    "lan-game",
    "party-game",
    "html5-game",
    "open-source"
  ],
  "author": "besoeasy",
  "license": "MIT",
  "homepage": "https://yantr.org/apps/l-town/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/besoeasy/l-town.git"
  },
  "bugs": {
    "url": "https://github.com/besoeasy/l-town/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
