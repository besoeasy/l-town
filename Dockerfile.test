FROM node:lts

# Install chromium and dependencies for headless browser execution
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    fonts-liberation \
    procps \
    curl \
    && rm -rf /var/lib/apt/lists/*

ENV CHROME_PATH=/usr/bin/chromium
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app
COPY package*.json ./
RUN npm ci || npm i
RUN npm i puppeteer-core
COPY . .
RUN npm run build

EXPOSE 30300
CMD ["npm", "run", "preview"]
